---
import Layout from "../layouts/Layout.astro";

import { projects } from "../data/projects";

const categories = ["All", ...new Set(projects.map((p) => p.label))];
---

<Layout title="All Projects" hideHeader={true} darkFooter={true} isDark={true}>
  {/* Hero Section */}
  <section
    class="relative pt-40 pb-24 overflow-hidden bg-[#050505] text-white"
  >
    {/* Background Effects */}
    <div class="absolute inset-0 pointer-events-none">
      <div
        class="absolute top-0 left-0 w-full h-full bg-[linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] bg-[size:40px_40px]"
      >
      </div>
      <div
        class="absolute top-[10%] left-[20%] w-[600px] h-[600px] bg-[radial-gradient(circle_at_center,rgba(37,99,235,0.1)_0%,transparent_70%)] rounded-full will-change-transform"
      >
      </div>
      <div
        class="absolute bottom-[10%] right-[10%] w-[500px] h-[500px] bg-[radial-gradient(circle_at_center,rgba(6,182,212,0.08)_0%,transparent_70%)] rounded-full will-change-transform"
      >
      </div>
    </div>

    <div class="container mx-auto px-4 relative z-10">
      {/* Breadcrumb */}
      <nav class="flex items-center gap-2 text-sm mb-12 animate-fade-in-up">
        <a
          href="/"
          class="text-gray-500 hover:text-white transition-colors duration-300 flex items-center gap-2"
        >
          <i class="fas fa-home text-xs"></i>
          Home
        </a>
        <i class="fas fa-chevron-right text-[10px] text-gray-600"></i>
        <span class="text-white font-semibold">Projects</span>
      </nav>

      {/* Page Header */}
      <div class="max-w-3xl animate-fade-in-up">
        <div class="flex items-center gap-4 mb-6">
          <div
            class="w-14 h-14 rounded-2xl bg-gradient-to-br from-blue-500 to-cyan-400 flex items-center justify-center shadow-lg shadow-blue-500/20"
          >
            <i class="fas fa-briefcase text-xl text-white"></i>
          </div>
          <div class="h-px flex-1 bg-gradient-to-r from-white/20 to-transparent">
          </div>
        </div>

        <h1
          class="text-5xl md:text-7xl font-black tracking-tight leading-[0.9] mb-6"
        >
          All<br />
          <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-300"
            >Projects</span
          >
        </h1>

        <p class="text-gray-400 text-lg md:text-xl leading-relaxed max-w-2xl">
          A curated collection of projects showcasing my expertise in system analysis
          and development, from enterprise web apps to smart IoT systems.
        </p>
      </div>

      {/* Stats Bar */}
      <div
        class="flex flex-wrap gap-8 mt-12 pt-8 border-t border-white/10 animate-fade-in-up"
        style="animation-delay: 0.2s"
      >
        <div>
          <div class="text-3xl font-black text-white">
            {projects.length}
          </div>
          <div
            class="text-xs text-gray-500 font-bold uppercase tracking-widest mt-1"
          >
            Total Projects
          </div>
        </div>
        <div>
          <div class="text-3xl font-black text-white">
            {categories.length - 1}
          </div>
          <div
            class="text-xs text-gray-500 font-bold uppercase tracking-widest mt-1"
          >
            Categories
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Projects Grid Section */}
  <section class="py-20 bg-[#050505] text-white relative min-h-screen">
    {/* Subtle top divider */}
    <div
      class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"
    >
    </div>

    <div class="container mx-auto px-4 relative z-10">
      {/* Category Filter */}
      <div
        class="flex flex-wrap justify-center gap-3 mb-16 animate-fade-in-up"
        id="filter-bar"
      >
        {
          categories.map((cat, i) => (
            <button
              class={`filter-btn px-6 py-3 rounded-xl text-sm font-bold transition-all duration-300 border ${
                i === 0
                  ? "bg-white text-black border-white shadow-lg shadow-white/10"
                  : "bg-white/5 text-gray-400 border-white/10 hover:bg-white/10 hover:text-white hover:border-white/20"
              }`}
              data-filter={cat}
            >
              {cat}
            </button>
          ))
        }
      </div>

      {/* Projects Grid */}
      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-[1400px] mx-auto"
        id="projects-grid"
      >
        {
          projects.map((project, index) => (
            <article
              class="project-card flex flex-col group relative rounded-2xl overflow-hidden bg-white/[0.03] border border-white/[0.06] hover:border-white/15 transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl hover:shadow-blue-500/5 animate-fade-in-up"
              data-category={project.label}
              style={`animation-delay: ${index * 0.1}s`}
            >
              {/* Image Container */}
              <div class="relative h-48 overflow-hidden shrink-0">
                <img
                  src={project.image}
                  alt={project.title}
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                  loading="lazy"
                />
                {/* Gradient Overlay */}
                <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] via-[#0a0a0a]/40 to-transparent" />

                {/* Number Badge */}
                <div class="absolute top-4 left-4">
                  <span class="text-4xl font-black text-white/[0.2] leading-none select-none drop-shadow-md">
                    {project.num}
                  </span>
                </div>

                {/* Category Badge */}
                <div class="absolute top-4 right-4">
                  <span
                    class={`px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-gradient-to-r ${project.color} text-white shadow-lg backdrop-blur-sm`}
                  >
                    <i class={`${project.icon} mr-1 text-[9px]`} />
                    {project.label}
                  </span>
                </div>

                {/* Hover Action Overlay */}
                <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-center justify-center gap-4">
                  <a
                    href={`/projects/${project.id}`}
                    class="w-14 h-14 rounded-2xl bg-white flex items-center justify-center text-black hover:bg-blue-400 hover:text-white transition-all duration-300 transform translate-y-4 group-hover:translate-y-0 shadow-xl"
                    aria-label={`View details for ${project.title}`}
                  >
                    <i class="fas fa-eye text-lg" />
                  </a>
                  {project.githubUrl !== "#" && (
                    <a
                      href={project.githubUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="w-14 h-14 rounded-2xl bg-white flex items-center justify-center text-black hover:bg-gray-800 hover:text-white transition-all duration-300 transform translate-y-4 group-hover:translate-y-0 shadow-xl"
                      style="transition-delay: 75ms"
                      aria-label={`View ${project.title} source`}
                    >
                      <i class="fab fa-github text-lg" />
                    </a>
                  )}
                </div>
              </div>

              {/* Content */}
              <div class="p-6 flex flex-col flex-grow">
                {/* Title */}
                <h2 class="text-lg font-black text-white mb-2 group-hover:text-transparent group-hover:bg-clip-text group-hover:bg-gradient-to-r group-hover:from-blue-400 group-hover:to-cyan-300 transition-all duration-300 line-clamp-1">
                  {project.title}
                </h2>

                {/* Description */}
                <p class="text-gray-400 text-xs leading-relaxed mb-4 line-clamp-2 flex-grow">
                  {project.description}
                </p>

                {/* Tags */}
                <div class="flex flex-wrap gap-1.5 mb-5 mt-auto">
                  {project.tags.slice(0, 3).map((tag) => (
                    <span class="px-2 py-1 bg-white/[0.04] border border-white/[0.08] rounded text-[10px] font-semibold text-gray-400">
                      {tag}
                    </span>
                  ))}
                  {project.tags.length > 3 && (
                    <span class="px-2 py-1 bg-white/[0.04] border border-white/[0.08] rounded text-[10px] font-semibold text-gray-400">
                      +{project.tags.length - 3}
                    </span>
                  )}
                </div>

                {/* Footer */}
                <div class="flex items-center justify-between pt-4 border-t border-white/[0.06]">
                  <a
                    href={`/projects/${project.id}`}
                    class="inline-flex items-center gap-2 text-xs font-bold text-white hover:text-blue-400 transition-colors duration-300 group/link"
                  >
                    View Project
                    <i class="fas fa-arrow-right text-[10px] group-hover/link:translate-x-1 transition-transform duration-300" />
                  </a>
                  <div class="flex items-center gap-2">
                    {project.liveUrl && project.liveUrl !== "#" && (
                      <a
                        href={project.liveUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="w-7 h-7 rounded-md bg-white/[0.06] flex items-center justify-center text-gray-500 hover:bg-blue-500 hover:text-white transition-all duration-300"
                        aria-label="Live site"
                      >
                        <i class="fas fa-external-link-alt text-[10px]" />
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </article>
          ))
        }
      </div>

      {/* Empty State */}
      <div
        id="empty-state"
        class="hidden text-center py-20 max-w-md mx-auto"
      >
        <div
          class="w-20 h-20 rounded-full bg-white/5 flex items-center justify-center mx-auto mb-6"
        >
          <i class="fas fa-folder-open text-3xl text-gray-600"></i>
        </div>
        <h3 class="text-xl font-bold text-white mb-2">No Projects Found</h3>
        <p class="text-gray-500 text-sm">
          No projects match the selected filter. Try a different category.
        </p>
      </div>
    </div>
  </section>

  {/* CTA Section */}
  <section class="py-24 bg-[#050505] text-white relative overflow-hidden">
    <div
      class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"
    >
    </div>
    <div
      class="absolute inset-0 pointer-events-none opacity-30"
    >
      <div
        class="absolute top-[50%] left-[50%] -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-[radial-gradient(circle_at_center,rgba(37,99,235,0.1)_0%,transparent_70%)] rounded-full will-change-transform"
      >
      </div>
    </div>

    <div class="container mx-auto px-4 relative z-10">
      <div
        class="max-w-3xl mx-auto text-center animate-fade-in-up"
      >
        <h2 class="text-4xl md:text-5xl font-black tracking-tight mb-6">
          Interested in<br />
          <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-300"
            >working together?</span
          >
        </h2>
        <p class="text-gray-400 text-lg mb-10 max-w-xl mx-auto">
          I'm always open to discussing new projects, creative ideas, or
          opportunities to be part of your vision.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="/#contact"
            class="group px-8 py-4 bg-white text-black rounded-2xl font-bold shadow-xl hover:shadow-2xl hover:shadow-blue-500/10 transition-all duration-300 transform hover:-translate-y-1 inline-flex items-center gap-3"
          >
            Get In Touch
            <i
              class="fas fa-arrow-right text-sm group-hover:translate-x-1 transition-transform"
            ></i>
          </a>
          <a
            href="/"
            class="group px-8 py-4 bg-white/5 border border-white/10 text-white rounded-2xl font-bold hover:bg-white/10 hover:border-white/20 transition-all duration-300 transform hover:-translate-y-1 inline-flex items-center gap-3"
          >
            <i class="fas fa-arrow-left text-sm"></i>
            Back to Home
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Filter animation */
  .project-card {
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
  }

  .project-card.hidden-card {
    opacity: 0;
    transform: scale(0.95) translateY(10px);
    pointer-events: none;
    position: absolute;
    visibility: hidden;
  }

  .project-card.visible-card {
    opacity: 1;
    transform: scale(1) translateY(0);
  }

  /* Line clamp */
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script>
  // Category Filter Logic
  const filterBtns = document.querySelectorAll(".filter-btn");
  const projectCards = document.querySelectorAll(".project-card");
  const emptyState = document.getElementById("empty-state");
  const grid = document.getElementById("projects-grid");

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const filter = btn.getAttribute("data-filter");

      // Update active button
      filterBtns.forEach((b) => {
        b.classList.remove(
          "bg-white",
          "text-black",
          "border-white",
          "shadow-lg",
          "shadow-white/10",
        );
        b.classList.add(
          "bg-white/5",
          "text-gray-400",
          "border-white/10",
        );
      });
      btn.classList.remove(
        "bg-white/5",
        "text-gray-400",
        "border-white/10",
      );
      btn.classList.add(
        "bg-white",
        "text-black",
        "border-white",
        "shadow-lg",
        "shadow-white/10",
      );

      // Filter cards
      let visibleCount = 0;
      projectCards.forEach((card) => {
        const category = card.getAttribute("data-category");
        if (filter === "All" || category === filter) {
          card.classList.remove("hidden-card");
          card.classList.add("visible-card");
          card.style.display = "";
          visibleCount++;
        } else {
          card.classList.add("hidden-card");
          card.classList.remove("visible-card");
          // Delay hiding to allow animation
          setTimeout(() => {
            if (card.classList.contains("hidden-card")) {
              card.style.display = "none";
            }
          }, 500);
        }
      });

      // Toggle empty state
      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.classList.remove("hidden");
        } else {
          emptyState.classList.add("hidden");
        }
      }
    });
  });

  // Scroll reveal animation
  const observerOptions = {
    threshold: 0.1,
    rootMargin: "0px 0px -50px 0px",
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add("animate-fade-in-up");
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  document.querySelectorAll(".project-card").forEach((card) => {
    observer.observe(card);
  });
</script>
