---
import Layout from "../../layouts/Layout.astro";
import { projects } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<Layout title={`${project.title} | Nafil Habibi`} hideHeader={true} darkFooter={true} isDark={true}>
  <section class="min-h-screen bg-[#050505] text-white pt-24 pb-20 relative overflow-hidden">
    {/* Background Abstract */}
    <div class="absolute inset-0 pointer-events-none opacity-20">
      <div
        class="absolute top-[10%] left-[20%] w-[600px] h-[600px] bg-[radial-gradient(circle_at_center,rgba(37,99,235,0.2)_0%,transparent_70%)] rounded-full will-change-transform"
      >
      </div>
      <div
        class="absolute bottom-[10%] right-[20%] w-[500px] h-[500px] bg-[radial-gradient(circle_at_center,rgba(6,182,212,0.1)_0%,transparent_70%)] rounded-full will-change-transform"
      >
      </div>
    </div>

    <div class="container mx-auto px-4 relative z-10 max-w-5xl">
      {/* Back Navigation */}
      <nav class="mb-12 animate-fade-in-up">
        <a
          href="/projects"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white/5 border border-white/10 hover:bg-white/10 text-gray-400 hover:text-white transition-all duration-300"
        >
          <i class="fas fa-arrow-left text-sm"></i>
          Back to Projects
        </a>
      </nav>

      {/* Project Header */}
      <div class="animate-fade-in-up" style="animation-delay: 0.1s">
        <div class="flex items-center gap-3 mb-6">
          <span
            class={`px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-widest bg-gradient-to-r ${project.color} text-white shadow-lg shadow-blue-500/20`}
          >
            <i class={`${project.icon} mr-2`} />
            {project.label}
          </span>
          <span class="text-gray-500 font-bold uppercase tracking-widest text-xs">
            Project {project.num}
          </span>
        </div>

        <h1 class="text-4xl md:text-6xl font-black tracking-tight leading-tight mb-8">
          {project.title}
        </h1>

        <div class="flex flex-wrap gap-2 mb-10">
          {project.tags.map((tag) => (
            <span class="px-4 py-2 bg-white/5 border border-white/10 rounded-lg text-sm font-semibold text-gray-300">
              {tag}
            </span>
          ))}
        </div>
      </div>

      {/* Project Cover Image */}
      <div 
        class="w-full h-[400px] md:h-[600px] rounded-3xl overflow-hidden mb-16 relative shadow-2xl animate-fade-in-up"
        style="animation-delay: 0.2s"
      >
        <img
          src={project.image}
          alt={project.title}
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#050505] via-transparent to-transparent"></div>
      </div>

      {/* Project Details */}
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 animate-fade-in-up" style="animation-delay: 0.3s">
        <div class="lg:col-span-2">
          <h2 class="text-2xl font-bold mb-6 text-white border-b border-white/10 pb-4">
            About the Project
          </h2>
          <div class="prose prose-invert prose-lg max-w-none text-gray-400 leading-relaxed">
            <p>
              {project.descriptionId || project.description}
            </p>
            {project.descriptionId && project.description && project.descriptionId !== project.description && (
              <p class="mt-4">
                {project.description}
              </p>
            )}
          </div>
        </div>

        {/* Links Sidebar */}
        <div class="space-y-6">
          {((project.liveUrl && project.liveUrl !== "#") || (project.githubUrl && project.githubUrl !== "#")) && (
            <div class="bg-white/[0.03] border border-white/[0.06] rounded-2xl p-6">
              <h3 class="text-sm font-bold text-gray-500 uppercase tracking-widest mb-6">
                Project Links
              </h3>
              
              {project.liveUrl && project.liveUrl !== "#" && (
                <a
                  href={project.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center justify-between p-4 bg-gradient-to-r from-blue-600 to-cyan-500 rounded-xl font-bold text-white shadow-lg shadow-blue-500/20 hover:shadow-blue-500/40 hover:-translate-y-1 transition-all duration-300 mb-4 group"
                >
                  <div class="flex items-center gap-3">
                    <i class="fas fa-globe text-xl"></i>
                    <span>Live Preview</span>
                  </div>
                  <i class="fas fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
                </a>
              )}

              {project.githubUrl && project.githubUrl !== "#" && (
                <a
                  href={project.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center justify-between p-4 bg-white/10 border border-white/10 rounded-xl font-bold text-white hover:bg-white/20 hover:-translate-y-1 transition-all duration-300 group"
                >
                  <div class="flex items-center gap-3">
                    <i class="fab fa-github text-xl"></i>
                    <span>Source Code</span>
                  </div>
                  <i class="fas fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
                </a>
              )}
            </div>
          )}
        </div>
      </div>
    </div>
  </section>
</Layout>
