---
import { projects } from "../data/projects";
---

<section
  id="home"
  class="relative min-h-screen flex items-center pt-32 pb-20 overflow-hidden bg-white"
>
  <!-- Minimalist Subtle Grid Background -->
  <div class="absolute inset-0 -z-20">
    <div
      class="absolute inset-0 bg-[linear-gradient(to_right,#8080800a_1px,transparent_1px),linear-gradient(to_bottom,#8080800a_1px,transparent_1px)] bg-[size:32px_32px]"
    >
    </div>
    <div
      class="absolute inset-0 bg-gradient-to-t from-white via-transparent to-transparent"
    >
    </div>
  </div>

  <div class="absolute inset-0 -z-10 opacity-15">
    <div
      class="absolute top-10 left-10 w-96 h-96 bg-[radial-gradient(circle_at_center,rgba(37,99,235,0.3)_0%,transparent_70%)] rounded-full blur-2xl pointer-events-none"
    >
    </div>
  </div>

  <!-- Main Content Container -->
  <div class="container mx-auto px-4 relative z-10">
    <div
      class="flex flex-col lg:flex-row items-center justify-between gap-12 lg:gap-16"
    >
      <!-- Profile Photo - Left Column -->
      <div
        class="relative group flex-shrink-0 lg:-mt-12"
        id="profile-container"
      >
        <div class="relative" id="tilt-card">
          <!-- Outer Clean Card -->
          <div
            class="relative w-64 h-64 md:w-80 md:h-80 rounded-3xl bg-gradient-to-br from-gray-100 to-gray-200 p-2 shadow-xl shadow-gray-900/5 border border-gray-200/80 transition-all duration-500 group-hover:shadow-2xl group-hover:border-blue-500/30"
          >
            <!-- Photo Frame -->
            <div
              class="w-full h-full rounded-2xl overflow-hidden bg-gray-900 relative"
            >
              <img
                src="/profile-photo.jpeg"
                alt="Nafil Habibi Mulyadi"
                class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700"
                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'"
              />
              <!-- Fallback -->
              <div
                class="absolute inset-0 hidden items-center justify-center bg-gray-950 text-white font-mono"
              >
                <span class="text-6xl font-black text-blue-500 tracking-tighter"
                  >NHM</span
                >
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Content - Right Column -->
      <div class="flex-1 max-w-2xl text-center lg:text-left">
        <!-- Terminal Style Status Badge -->
        <div
          class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-lg bg-slate-900 border border-blue-500/30 font-mono text-xs text-blue-400 shadow-sm shadow-blue-500/10 mb-6 cursor-default animate-fade-in-up"
          style="animation-delay: 0.1s"
        >
          <span class="text-blue-500/60 font-bold">[</span>

          <span
            class="tracking-widest font-semibold uppercase"
            data-i18n="hero.status">This Area Build With Astro</span
          >
          <span class="text-blue-500/60 font-bold">]</span>
        </div>

        <!-- Name & Role -->
        <div class="mb-6 animate-fade-in-up" style="animation-delay: 0.2s">
          <div
            class="inline-block px-5 py-3.5 md:px-7 md:py-4 rounded-2xl bg-gray-950 border border-gray-800 text-white shadow-xl mb-3"
          >
            <h1
              class="text-3xl md:text-5xl lg:text-6xl font-black tracking-tight leading-none text-white"
            >
              Nafil Habibi <span class="text-gray-400 font-bold">Mulyadi</span>
            </h1>
          </div>
          <div
            class="flex items-center gap-3 justify-center lg:justify-start mt-2"
          >
            <span class="font-mono text-gray-400 text-sm font-semibold">//</span
            >
            <h2
              class="text-lg md:text-xl font-bold text-gray-500 uppercase tracking-[0.15em] font-mono"
              data-i18n="hero.role"
            >
              System Analyst
            </h2>
          </div>
        </div>

        <!-- Description -->
        <p
          class="text-gray-600 text-base md:text-lg mb-8 max-w-xl leading-relaxed animate-fade-in-up font-normal"
          style="animation-delay: 0.3s"
          data-i18n="hero.desc"
        >
          Architecting high-performance digital solutions by bridging innovative
          UI/UX design with robust, scalable software engineering.
        </p>

        <!-- CTA Buttons -->
        <div
          class="flex flex-wrap justify-center lg:justify-start gap-4 mb-10 animate-fade-in-up"
          style="animation-delay: 0.4s"
        >
          <a
            href="/projects"
            class="group px-7 py-3.5 bg-gray-900 hover:bg-blue-600 text-white rounded-xl font-semibold shadow-md hover:shadow-lg transition-all duration-300 inline-flex items-center gap-2.5 font-mono text-sm"
          >
            <span data-i18n="hero.portfolio">View Portfolio</span>
            <i
              class="fas fa-arrow-right text-xs group-hover:translate-x-1 transition-transform"
            ></i>
          </a>
          <a
            href="/Nafil_Habibi_Mulyadi_CV.pdf"
            class="group px-7 py-3.5 bg-white border border-gray-300 text-gray-800 rounded-xl font-semibold hover:border-gray-900 shadow-sm hover:shadow-md transition-all duration-300 inline-flex items-center gap-2.5 font-mono text-sm"
          >
            <span data-i18n="hero.cv">Download CV</span>
            <i
              class="fas fa-download text-xs group-hover:translate-y-0.5 transition-transform"
            ></i>
          </a>
        </div>

        <!-- Tech Stack Tags -->
        <div class="animate-fade-in-up mb-10" style="animation-delay: 0.5s">
          <p
            class="text-gray-400 font-mono text-xs uppercase tracking-widest mb-3"
            data-i18n="hero.tech"
          >
            // CORE TECH STACK
          </p>
          <div class="flex flex-wrap justify-center lg:justify-start gap-2.5">
            {
              [
                { name: "React", icon: "fab fa-react", color: "text-sky-500" },
                {
                  name: "Astro",
                  icon: "fas fa-rocket",
                  color: "text-orange-500",
                },
                {
                  name: "Node.js",
                  icon: "fab fa-node-js",
                  color: "text-emerald-600",
                },
                {
                  name: "Tailwind",
                  icon: "fas fa-wind",
                  color: "text-cyan-500",
                },
                {
                  name: "Python",
                  icon: "fab fa-python",
                  color: "text-blue-500",
                },
                {
                  name: "Laravel",
                  icon: "fab fa-laravel",
                  color: "text-red-500",
                },
              ].map((tech) => (
                <span class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-gray-50 border border-gray-200/80 rounded-lg text-xs font-mono text-gray-700 hover:bg-white hover:border-gray-400 transition-all cursor-default shadow-sm">
                  <i class={`${tech.icon} ${tech.color}`} />
                  {tech.name}
                </span>
              ))
            }
          </div>
        </div>

        <!-- Minimalist Stats -->
        <div
          class="grid grid-cols-2 md:grid-cols-4 gap-4 pt-6 border-t border-gray-100 animate-fade-in-up"
          style="animation-delay: 0.6s"
        >
          <div>
            <div
              class="text-2xl md:text-3xl font-black text-gray-900 font-mono"
            >
              {projects.length}
            </div>
            <div
              class="text-gray-400 font-mono text-[11px] uppercase tracking-wider mt-0.5"
              data-i18n="hero.stats.projects"
            >
              Projects
            </div>
          </div>
          <div>
            <div
              class="text-2xl md:text-3xl font-black text-gray-900 font-mono"
            >
              4+
            </div>
            <div
              class="text-gray-400 font-mono text-[11px] uppercase tracking-wider mt-0.5"
              data-i18n="hero.stats.exp"
            >
              Years Exp
            </div>
          </div>
          <div>
            <div
              class="text-2xl md:text-3xl font-black text-gray-900 font-mono"
            >
              100%
            </div>
            <div
              class="text-gray-400 font-mono text-[11px] uppercase tracking-wider mt-0.5"
              data-i18n="hero.stats.satisfaction"
            >
              Satisfaction
            </div>
          </div>
          <div>
            <div
              class="text-2xl md:text-3xl font-black text-gray-900 font-mono"
            >
              24/7
            </div>
            <div
              class="text-gray-400 font-mono text-[11px] uppercase tracking-wider mt-0.5"
              data-i18n="hero.stats.support"
            >
              Support
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* 3D Tilt */
  #tilt-card {
    will-change: transform;
    transition: transform 0.2s cubic-bezier(0.23, 1, 0.32, 1);
  }

  /* Fade In Animation */
  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-fade-in-up {
    animation: fade-in-up 0.5s ease-out forwards;
  }
</style>

<script lang="ts">
  // Subtle 3D Tilt Effect for Profile Photo
  document.addEventListener("DOMContentLoaded", () => {
    const tiltCard = document.getElementById("tilt-card");
    const profileContainer = document.getElementById("profile-container");

    if (profileContainer && tiltCard) {
      let isTicking = false;

      profileContainer.addEventListener(
        "mousemove",
        (e) => {
          if (!isTicking) {
            window.requestAnimationFrame(() => {
              const rect = profileContainer.getBoundingClientRect();
              const x = e.clientX - rect.left;
              const y = e.clientY - rect.top;
              const centerX = rect.width / 2;
              const centerY = rect.height / 2;
              const rotateX = (y - centerY) / 12;
              const rotateY = (centerX - x) / 12;

              tiltCard.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;
              isTicking = false;
            });
            isTicking = true;
          }
        },
        { passive: true },
      );

      profileContainer.addEventListener("mouseleave", () => {
        tiltCard.style.transform =
          "perspective(1000px) rotateX(0) rotateY(0) scale3d(1, 1, 1)";
      });
    }
  });
</script>
